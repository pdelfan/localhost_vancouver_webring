---
import { getEntry } from "astro:content";

const entry = await getEntry("people", "index");
const title = entry.data.title;
const { Content } = await entry.render();
---

<div class="grid grid-cols-1 gap-3">
    <h2 class="bg-zinc-700 p-3">
        [{title}]
    </h2>
    <div class="content">
        <Content />
    </div>
</div>
