---
import { getEntry } from "astro:content";

const entry = await getEntry("projectsAndEvents", "index");
const title = entry.data.title;
const { Content } = await entry.render();
---

<div class="grid grid-cols-1 gap-3">
    <h2 class="text-secondary border-2 border-secondary p-3 rounded-md">
        {title}
    </h2>
    <p>
        Feel free to list your Projects, Events, or other resources that don't
        fit into the other categories.
    </p>
    <div class="content">
        <Content />
    </div>
</div>
